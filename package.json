{
  "name": "everyhint",
  "productName": "EveryHint",
  "version": "0.4.0",
  "private": true,
  "description": "EveryHint \u00e2\u20ac\u201d Intelligence when you need it.",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "theme:build": "node scripts/build-theme.mjs",
    "theme:check": "node scripts/build-theme.mjs --check",
    "spec:build": "node scripts/build-feature-matrix.mjs",
    "spec:check": "node scripts/build-feature-matrix.mjs --check",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "smoke:intelligence": "node scripts/smoke-intelligence.mjs",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "intelligence:bench": "vitest run tests/intelligence-benchmark.test.ts",
    "intelligence:screen-bench": "node scripts/benchmark-screen.mjs",
    "build": "electron-vite build",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run theme:check && npm run spec:check && npm run typecheck && npm run lint && npm test && npm run build",
    "speech:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-transcriber.ps1",
    "speech:model": "node scripts/install-model.mjs",
    "speech:test": "node --experimental-transform-types scripts/test-inference.mjs",
    "smoke:speech": "node scripts/smoke-transcription.mjs",
    "test:ai-sdk": "vitest run --config vitest.sdk.config.ts",
    "smoke:ai": "node scripts/smoke-ai.mjs",
    "test:plan": "vitest run --config vitest.plan.config.ts",
    "test:meetings": "node scripts/test-meeting-storage.mjs",
    "smoke:meetings": "node scripts/smoke-meetings.mjs",
    "smoke:personal": "node scripts/smoke-personal.mjs",
    "personal:bench": "node scripts/benchmark-personal.mjs",
    "smoke:context": "node scripts/smoke-context.mjs",
    "context:bench": "node scripts/benchmark-context.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.311",
    "@napi-rs/keyring": "2.1.2",
    "@openai/codex-sdk": "0.164.0",
    "fflate": "0.8.3",
    "jose": "6.2.13",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "playwright-core": "1.64.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
