{
  "name": "everyhint",
  "productName": "EveryHint",
  "version": "0.4.0",
  "private": true,
  "description": "EveryHint — Intelligence when you need it.",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "electron-vite build",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "speech:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-transcriber.ps1",
    "speech:model": "node scripts/install-model.mjs",
    "speech:test": "node --experimental-transform-types scripts/test-inference.mjs",
    "smoke:speech": "node scripts/smoke-transcription.mjs",
    "test:ai-sdk": "vitest run --config vitest.sdk.config.ts",
    "smoke:ai": "node scripts/smoke-ai.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.311",
    "@openai/codex-sdk": "0.164.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "playwright-core": "1.64.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
